# Bullionova Price Alerts server configuration.
# Copy variable names into the host provider. Do not commit real secret values.

BULLIONOVA_PRICE_ALERTS_SERVER_ENABLED=false
BULLIONOVA_PRICE_ALERTS_WORKER_ENABLED=false
BULLIONOVA_ENVIRONMENT=production
BULLIONOVA_PRICE_ALERTS_ALLOW_TEST_ENTITLEMENTS=false
BULLIONOVA_PRICE_ALERTS_ALLOW_SYNTHETIC_QUOTES=false
DATABASE_URL=

# Token protection. PRICE_ALERTS_TOKEN_ENCRYPTION_KEYS accepts comma-separated
# version:key entries. Generate Fernet keys with a trusted local tool.
PRICE_ALERTS_TOKEN_HASH_KEY=
PRICE_ALERTS_TOKEN_ENCRYPTION_KEYS=

# Metals-API Bronze plan safety. The application hard limit must stay below the
# paid plan ceiling so defects cannot consume uncontrolled overage calls.
METALS_API_KEY=
PRICE_ALERTS_METALS_POLL_INTERVAL_SECONDS=600
PRICE_ALERTS_METALS_PLAN_LIMIT=5000
PRICE_ALERTS_METALS_APPLICATION_HARD_LIMIT=4800
PRICE_ALERTS_METALS_WARNING_THRESHOLD=4500
PRICE_ALERTS_METALS_BILLING_CYCLE_ANCHOR_DAY=1

# Legacy dealer API process controls. Keep these false for Price Alerts staging
# so the web service does not run the older dealer/spot refresher alongside the
# dedicated Price Alerts worker.
DEALER_API_STARTUP_COLLECT=false
DEALER_API_BACKGROUND_REFRESH=false
DEALER_API_METALS_CACHE_ENABLED=false

# FX provider boundary. Keep disabled until provider licensing is approved for
# server-backed public alert evaluation.
PRICE_ALERTS_FX_PROVIDER_ENABLED=false
PRICE_ALERTS_FX_FRESHNESS_SECONDS=90000

# Firebase Admin delivery. Use host-managed credentials or a host-mounted
# service account file; never commit the JSON key.
PRICE_ALERTS_FCM_ENABLED=false
PRICE_ALERTS_FIREBASE_CREDENTIALS_FILE=

# Google Play subscription verification.
PRICE_ALERTS_PLAY_VERIFICATION_ENABLED=false
PRICE_ALERTS_GOOGLE_PLAY_CREDENTIALS_FILE=
PRICE_ALERTS_ANDROID_PACKAGE_ID=com.northstack.stackwatch
PRICE_ALERTS_PLAY_PRODUCT_ID=stackwatch_pro

# Evaluator and sync limits.
PRICE_ALERTS_SPOT_FRESHNESS_SECONDS=2100
PRICE_ALERTS_MAX_RESUMABLE_ALERTS=50
PRICE_ALERTS_MAX_VISIBLE_TRIGGER_EVENTS=100
PRICE_ALERTS_WORKER_BATCH_SIZE=100
PRICE_ALERTS_MAX_TEST_ENTITLEMENT_TTL_HOURS=24

# Public API metadata and optional deployment controls.
PRICE_ALERTS_PUBLIC_BACKEND_BASE_URL=https://stackwatch-dealer-backend.onrender.com
PRICE_ALERTS_CORS_ALLOWLIST=
PRICE_ALERTS_LOG_LEVEL=INFO
